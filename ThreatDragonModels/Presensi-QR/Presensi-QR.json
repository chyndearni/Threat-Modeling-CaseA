            "zIndex": 8,
            "id": "909e2eb8-30d8-51a5-9e5a-dc2cb0afce96",
            "data": {
              "type": "tm.Process",
              "name": "Backend Presensi",
              "description": "Membuat sesi/QR, validasi sesi dan status mahasiswa, catat kehadiran, muat rekap",
              "outOfScope": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "isTrustBoundary": false,
              "threats": [
                {
                  "id": "b2e076e3-39a9-5d0f-a938-1268cc57eb1e",
                  "title": "Dosen membuka sesi untuk kelas yang bukan diampunya",
                  "status": "Open",
                  "severity": "High",
                  "type": "Elevation of Privilege",
                  "description": "Jika dosen (atau akun yang disalahgunakan) dapat mengubah ID kelas pada permintaan buka sesi ke Backend Presensi, maka bisa terjadi sesi dibuat untuk kelas lain dan melanggar aturan bisnis hanya dosen pengampu yang boleh membuka sesi.\n\nPenilaian: Kemungkinan 2 × Dampak 3 = 6 (Tinggi). Kemungkinan sedang karena bergantung pada ada tidaknya pemeriksaan otorisasi per kelas (asumsi A4); dampak tinggi karena presensi kelas lain menjadi tidak sah.",
                  "mitigation": "Backend memeriksa hubungan dosen–kelas di Database Akademik pada setiap permintaan buka/tutup sesi; ID kelas tidak dipercaya dari klien; tolak dan catat percobaan yang gagal.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 2,
                  "score": "6"
                },
                {
                  "id": "23ccefca-7efe-5db2-883c-674387b9d91a",
                  "title": "Penyangkalan buka/tutup sesi dan kehadiran karena jejak audit lemah",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Repudiation",
                  "description": "Jika dosen atau mahasiswa dapat menyangkal telah membuka/menutup sesi atau melakukan presensi karena log aktivitas tidak memadai pada Backend Presensi, maka bisa terjadi sengketa kehadiran yang tidak dapat dibuktikan.\n\nPenilaian: Kemungkinan 2 × Dampak 2 = 4 (Sedang). Kemungkinan sedang karena deskripsi tidak menyebut audit log (asumsi A5, belum tentu tidak ada); dampak sedang karena menyulitkan penyelesaian sengketa.",
                  "mitigation": "Catat log audit (siapa, kapan, aksi, ID sesi/kelas) untuk buka/tutup sesi dan presensi; log hanya dapat ditambah, tidak diubah; sinkronkan waktu server.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 5,
                  "score": "4"
                },
                {
                  "id": "1a732bc0-d14e-5afa-9ae3-d6a75564f878",
                  "title": "Banjir permintaan pada Backend saat jendela presensi lima menit",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Denial of Service",
                  "description": "Jika banyak permintaan (mahasiswa serentak atau skrip otomatis) dikirim ke Backend Presensi dalam jendela lima menit, maka bisa terjadi layanan lambat atau tidak tersedia dan sebagian mahasiswa gagal presensi tepat waktu.\n\nPenilaian: Kemungkinan 2 × Dampak 2 = 4 (Sedang). Kemungkinan sedang karena lonjakan di awal sesi lazim terjadi; dampak sedang karena mengganggu sebagian pengguna dan bersifat sementara.",
                  "mitigation": "Rate limiting per akun dan per IP pada endpoint presensi; antrean atau penskalaan backend; indeks pada tabel sesi dan kehadiran; pemantauan beban.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 7,
                  "score": "4"
                }
              ],
              "privilegeLevel": "",
              "isWebApplication": true,
              "handlesCardPayment": false,
              "handlesGoodsOrServices": false,
              "isOutOfScope": false
            }
          },
