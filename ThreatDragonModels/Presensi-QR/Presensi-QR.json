              "hasOpenThreats": true,
              "isTrustBoundary": false,
              "threats": [
                {
                  "id": "c3c93460-2d1e-59db-98db-b2bc45ec662a",
                  "title": "Kebocoran data identitas dan kehadiran dari Database Akademik",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Information Disclosure",
                  "description": "Jika pihak tidak berwenang dapat membaca Database Akademik (akses langsung atau kredensial database bocor), maka bisa terjadi kebocoran identitas pengguna, keanggotaan kelas, dan catatan kehadiran.\n\nPenilaian: Kemungkinan 1 × Dampak 3 = 3 (Sedang). Kemungkinan rendah karena database berada di zona internal (asumsi A1); dampak tinggi karena memuat data pribadi banyak mahasiswa.",
                  "mitigation": "Database hanya dapat diakses dari Backend Presensi; akun database dengan hak minimal; kredensial disimpan aman di luar kode; enkripsi data tersimpan jika tersedia.",
                  "modelType": "STRIDE",
