              "threats": [
                {
                  "id": "19ba7c9e-0ff5-5bc6-8cfb-907dd73c5fda",
                  "title": "Titip presensi memakai akun mahasiswa orang lain",
                  "status": "Open",
                  "severity": "High",
                  "type": "Spoofing",
                  "description": "Jika mahasiswa dapat meminjam/memakai kredensial atau sesi login mahasiswa lain pada Mahasiswa (aktor), maka bisa terjadi catatan kehadiran palsu atas nama orang yang tidak hadir.\n\nPenilaian: Kemungkinan 3 × Dampak 2 = 6 (Tinggi). Kemungkinan tinggi karena berbagi akun mudah dilakukan; dampak sedang karena merusak keabsahan data presensi tetapi tidak membocorkan data sensitif.",
                  "mitigation": "Autentikasi kuat lewat layanan autentikasi kampus (misal MFA); batasi satu sesi aktif per akun; catat IP/perangkat saat presensi untuk bahan audit dosen.",
                  "modelType": "STRIDE",
